# ==============================================================================
# NIZALO ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual production/staging values.
# NEVER commit the real .env file to Git!
# ==============================================================================

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"
DATABASE_URL_UNPOOLED="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"
PORT=3000

# Cryptographic Keys (Base64-encoded 32-byte keys for session & token encryption)
AUTH_SIGNING_KEY_B64="YOUR_BASE64_SIGNING_KEY"
AUTH_ENCRYPTION_KEY_B64="YOUR_BASE64_ENCRYPTION_KEY"

# CORS & Internal API
CORS_ORIGINS="http://localhost:3000,https://nizalo.com,https://app.nizalo.com"
API_INTERNAL_URL="http://127.0.0.1:4000"

# OxaPay Crypto Cashier
OXAPAY_MERCHANT_API_KEY="YOUR_OXAPAY_MERCHANT_API_KEY"
OXAPAY_PAYOUT_API_KEY="YOUR_OXAPAY_PAYOUT_API_KEY"
OXAPAY_CALLBACK_URL="https://nizalo.com/v1/payments/oxapay/webhook"
CHAIN_READER="tron"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="https://nizalo.com/api/auth/google/callback"

# SMTP Email Services (Hostinger / Custom)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="info@nizalo.com"
SMTP_PASS="YOUR_HOSTINGER_EMAIL_PASSWORD"
