<?xml version="1.0" encoding="utf-8"?>
<!-- Dev builds only: plain HTTP allowed so the app can reach a backend on the emulator host or the LAN. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
