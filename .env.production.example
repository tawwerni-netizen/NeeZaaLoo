# ==============================================================================
# NIZALO ARENA - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env on your production server and fill in your credentials.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# Use direct connection or session/transaction pooler.
# The monolith server handles connection pooling (max 8 connections) and circuit breaking.
DATABASE_URL="postgresql://postgres:your_db_password@your-pooler-or-direct-host.com:5432/postgres"

# Optional direct URL (unpooled) for heavy DDL migrations:
DATABASE_URL_UNPOOLED="postgresql://postgres:your_db_password@your-pooler-or-direct-host.com:5432/postgres"

# Shared connection pool size per Node.js instance (default: 8)
DB_POOL_SIZE=8

# Set to "true" ONLY if scaling horizontally across multiple Node.js processes using PG LISTEN/NOTIFY.
# For single-instance monolith (recommended on Hostinger), keep "false" to use 0 database connections for bus.
USE_PG_BUS=false

# ------------------------------------------------------------------------------
# 2. APPLICATION & MONOLITH SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
CORS_ORIGINS=https://nizalo.com,https://app.nizalo.com

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY KEYS
# ------------------------------------------------------------------------------
# 32-byte Base64-encoded signing and encryption keys for JWTs and session encryption
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SIGNING_KEY_B64=your_base64_encoded_32_byte_signing_key_here=
AUTH_ENCRYPTION_KEY_B64=your_base64_encoded_32_byte_encryption_key_here=

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://nizalo.com/api/auth/google/callback

# ------------------------------------------------------------------------------
# 5. CRYPTO CASHFLOW (OXAPAY INTEGRATION)
# ------------------------------------------------------------------------------
OXAPAY_MERCHANT_API_KEY=your_oxapay_merchant_api_key
OXAPAY_PAYOUT_API_KEY=your_oxapay_payout_api_key
OXAPAY_CALLBACK_URL=https://nizalo.com/v1/payments/oxapay/webhook
CHAIN_READER=tron

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (RESEND OR HOSTINGER SMTP)
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended for 99.9% inbox deliverability)
# RESEND_API_KEY=re_your_api_key_here

# Option B: Hostinger SMTP (Included with your domain on Hostinger)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@nizalo.com
# SMTP_PASS=your_email_password_here

# ------------------------------------------------------------------------------
# 7. WEB PUSH NOTIFICATIONS (RFC 8291 / RFC 8292 VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@nizalo.com
