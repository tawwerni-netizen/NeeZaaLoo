# Nizalo Platform - Hostinger LiteSpeed / Apache Reverse Proxy Configuration
DirectoryIndex disabled
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Forward WebSocket connections to port 3000
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule ^(.*)$ ws://127.0.0.1:3000/$1 [P,L]

  # 2. Forward all HTTP requests to Node.js application on port 3000
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>
