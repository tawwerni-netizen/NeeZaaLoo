{
  "name": "nizalo",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "check:secrets": "node scripts/check-secrets.mjs",
    "build": "npm run build --workspace=apps/web",
    "start": "node server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "maintenance:vacuum": "node scripts/periodic_vacuum_and_cleanup.mjs",
    "maintenance:daemon": "node scripts/periodic_vacuum_and_cleanup.mjs --daemon --interval=4h"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@node-rs/argon2": "^2.2.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
