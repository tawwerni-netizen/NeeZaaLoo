{
  "name": "nizalo",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b --pretty",
    "build": "npm run build --workspace=apps/web",
    "start": "node server.js",
    "maintenance:vacuum": "node scripts/periodic_vacuum_and_cleanup.mjs",
    "maintenance:daemon": "node scripts/periodic_vacuum_and_cleanup.mjs --daemon --interval=6h"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
